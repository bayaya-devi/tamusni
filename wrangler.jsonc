  "compatibility_date": "2026-09-24",
  "vars": { "PUBLIC_SITE_URL": "https://tamusni.pages.dev", "NEWSLETTER_TIMEZONE": "Africa/Casablanca", "SOCIAL_PUBLISHING_MODE": "test", "META_GRAPH_API_VERSION": "v24.0", "TURNSTILE_SITE_KEY": "0x4AAAAAAFSPaQ4pJ26_lLSy", "TURNSTILE_REQUIRED": "true" },
  "ai": { "binding": "AI" },
  "d1_databases": [{ "binding": "DB", "database_name": "tamusni-production", "database_id": "94449680-e5b3-496b-a0f9-27eb55b4b696", "migrations_dir": "migrations" }],
  "observability": { "enabled": true }
}
