{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tamusni-editorial-automation",
  "main": "src/index.js",
  "compatibility_date": "2026-09-30",
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "PUBLIC_ORIGIN": "https://tamusni.pages.dev",
    "EDITORIAL_START_DATE": "2026-10-01",
    "EDITORIAL_TIME_ZONE": "Africa/Casablanca"
  },
  "ai": { "binding": "AI" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "tamusni-production",
    "database_id": "94449680-e5b3-496b-a0f9-27eb55b4b696",
    "migrations_dir": "../migrations"
  }]
}
